PORT=4000
REDIS_URL=redis://localhost:6379
QUEUE_NAME=bot-jobs
MAX_CONCURRENT_BOTS=10
BOT_IMAGE=botworker:latest
BOT_MEMORY_LIMIT=2147483648
BOT_CPU_LIMIT=2000000000
BOT_SHM_SIZE=2147483648
BOT_NETWORK=bot-network
# Host path mounted into bot containers at /tmp/recordings
# Must be an absolute path (Docker bind mounts require it)
BOT_RECORDINGS_DIR=/absolute/path/to/BotWorker/recordings
HEARTBEAT_TIMEOUT_MS=300000
ZOMBIE_REAPER_INTERVAL_MS=60000
MAX_MEETING_DURATION_MS=14400000
# ORCHESTRATOR_URL is passed to bot containers as BACKEND_URL (for sending events).
# Bot containers run in Docker, so they need host.docker.internal to reach the
# native orchestrator on the host machine.
ORCHESTRATOR_URL=http://host.docker.internal:4000

# Event-forwarder runs natively (not in Docker), so use localhost to reach core_api.
BACKEND_CALLBACK_URL=http://localhost:8005/api/internal/webhooks/bot-events
TRANSCRIPTION_URL=http://host.docker.internal:8000
STORAGE_BACKEND=local
LOG_LEVEL=info

# Must match core_api INTERNAL_SERVICE_KEY for webhook auth
INTERNAL_SERVICE_KEY=dev-service-key-do-not-use-in-production

# Database (for transcription job queue — shared videoclip_db)
DATABASE_URL=postgresql://videoclip:videoclipdev@localhost:5432/videoclip_db
