# Frontend — Local Development
# Next.js loads this automatically when running `npm run dev`.

# Leave empty — relative URLs proxied by Next.js rewrites
NEXT_PUBLIC_API_URL=

# Rewrite destinations (server-side only, not exposed to browser)
AUTH_SERVICE_URL=http://localhost:8001
CORE_API_URL=http://localhost:8005

# Phase 1 (notetaker-email plan §6): the email users invite to schedule a meeting via the Capture > Schedule new meeting popup.
NEXT_PUBLIC_MEMOIR_BOT_INVITE_EMAIL=hello@meetmemoir.com

# Meetings + Events v3 (plan/meetings-events-v3-list.md). Defaults to true in dev so the new UI is exercised locally; prod flip gated on QA completion.
NEXT_PUBLIC_FEATURE_MEETINGS_LIST_V3=true
NEXT_PUBLIC_FEATURE_EVENTS_LIST_V3=true
