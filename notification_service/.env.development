# Notification Service — Local Development

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8002

# Option 1: Gmail SMTP (easiest for dev)
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an app password
# 3. Fill in below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Option 2: SendGrid API (leave blank if using SMTP)
SENDGRID_API_KEY=

FROM_EMAIL=
FROM_NAME=Memoir

# Database (shared videoclip_db — core_api owns migrations)
DATABASE_URL=postgresql+asyncpg://videoclip:videoclipdev@localhost:5432/videoclip_db

# Must match auth service INTERNAL_SERVICE_KEY
INTERNAL_SERVICE_KEY=dev-service-key-do-not-use-in-production
