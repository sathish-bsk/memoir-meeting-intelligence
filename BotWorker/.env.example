# BotWorker Configuration

# Backend URL for sending events
BACKEND_URL=http://host.docker.internal:3000

# TranscriptionBase URL
TRANSCRIPTION_URL=http://host.docker.internal:8000

# Bot settings
BOT_NAME=Meeting Notetaker
DISPLAY=:99

# PulseAudio
PULSE_SINK_NAME=bot_sink

# Recording
CHUNK_DURATION_SECONDS=30
FFMPEG_AUDIO_BITRATE=48k

# Storage
STORAGE_BACKEND=local
STORAGE_DIR=/tmp/recordings

# Timeouts
WAITING_ROOM_TIMEOUT_SECONDS=120
HEARTBEAT_INTERVAL_SECONDS=30
MEETING_MAX_DURATION_SECONDS=14400
TRANSCRIPTION_TIMEOUT=600

# Logging
LOG_LEVEL=INFO
