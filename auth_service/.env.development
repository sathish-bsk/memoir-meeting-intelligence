# Auth Service — Local Development
# All values hardcoded for zero-config local dev.

ENVIRONMENT=development
LOG_LEVEL=DEBUG
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:3000

# Database (local Postgres via Docker)
DATABASE_URL=postgresql+asyncpg://videoclip:videoclipdev@localhost:5432/auth_db

# Redis (local via Docker)
REDIS_URL=redis://localhost:6379/0

# JWT keypair (auto-generated on first boot)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Inter-service auth (shared across all services in dev)
INTERNAL_SERVICE_KEY=dev-service-key-do-not-use-in-production

# Notification service
NOTIFICATION_SERVICE_URL=http://localhost:8002

# OAuth — leave blank to disable in dev
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback/google
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_REDIRECT_URI=http://localhost:3000/oauth/callback/microsoft

# Fernet key for encrypting OAuth tokens at rest (generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# Password policy — relaxed for dev
PASSWORD_MIN_LENGTH=8
HIBP_CHECK_ENABLED=false
