# Core API — Local Development
# All values hardcoded for zero-config local dev.

ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database (local Postgres via Docker)
DATABASE_URL=postgresql+asyncpg://videoclip:videoclipdev@localhost:5432/videoclip_db

# Redis (local via Docker, DB index 1)
REDIS_URL=redis://localhost:6379/1

# JWT (public key only — copied from auth_service/keys/)
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Inter-service auth (must match auth service)
INTERNAL_SERVICE_KEY=dev-service-key-do-not-use-in-production

# Service URLs (local dev ports)
AUTH_SERVICE_URL=http://localhost:8001
ORCHESTRATOR_URL=http://localhost:4000
BOT_CALLBACK_URL=http://localhost:8005/api/internal/webhooks/bot-events
BILLING_SERVICE_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8002
CRM_SERVICE_URL=http://localhost:8004

# Storage (local filesystem)
STORAGE_BACKEND=local
DATA_DIR=./data

# BotWorker recordings (host path where bot containers write output)
BOT_RECORDINGS_DIR=../BotWorker/recordings

# Zoom Cloud Recording
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ENCRYPTION_KEY=
CALENDAR_WEBHOOK_BASE_URL=https://fc07-2401-4900-1cc9-c7dd-394c-aab0-14f7-289d.ngrok-free.app
CALENDAR_ENCRYPTION_KEY=
GOOGLE_MEET_PUBSUB_TOPIC=
