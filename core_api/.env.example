# Core API — Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://core_user:corepass@localhost:5432/videoclip_db

# Redis (DB index 1 — auth uses 0)
REDIS_URL=redis://localhost:6379/1

# JWT (public key only — copy from auth_service/keys/public.pem)
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Inter-service authentication (must match all services)
INTERNAL_SERVICE_KEY=dev-service-key-change-in-production

# Service URLs
AUTH_SERVICE_URL=http://localhost:8001
ORCHESTRATOR_URL=http://localhost:4000
BILLING_SERVICE_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8002
CRM_SERVICE_URL=http://localhost:8004

# Storage (local for dev, s3 for prod)
STORAGE_BACKEND=local
DATA_DIR=./data
# S3_BUCKET=videoclip-data
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1

# Server
ENVIRONMENT=development
LOG_LEVEL=INFO
